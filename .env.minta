# Masold at ".env" neven, es toltsd ki. A .env SOHA ne keruljon a repoba (gitignore-ban van).
# Copy this file as ".env" and fill it in. Never commit the real .env.

# ---------- Halozat / Network ----------
# mainnet = Arc (eles, chain id 5042)   |   testnet = Arc Testnet (chain id 5042002)
ARC_HALOZAT=mainnet
# Opcionalis sajat RPC (Alchemy, QuickNode, dRPC, Blockdaemon). Ures = Circle publikus endpoint.
# ARC_RPC_URL=https://arc-mainnet.g.alchemy.com/v2/YOUR_KEY

# ---------- Circle (developer-controlled wallets + smart contract platform) ----------
# MAINNET: a Circle Console LIVE kornyezetenek kulcsa kell (a TEST kulcs mainneten nem mukodik).
# TESTNET: a TEST kornyezet kulcsa.
# API key: https://console.circle.com   Entity secret: https://developers.circle.com/wallets/dev-controlled/register-entity-secret
CIRCLE_API_KEY=YOUR_CIRCLE_API_KEY
CIRCLE_ENTITY_SECRET=YOUR_ENTITY_SECRET

# ---------- Tarcak (Circle developer-controlled tarcak cimei az adott halozaton) ----------
# A DEX telepitoje = a szerzodes TULAJDONOSA (pause/unpause, pool-letrehozas). Mainneten kulon ovd.
TELEPITO_CIM=0x0000000000000000000000000000000000000000
# A webapp Circle-modjanak tarcaja (kezdo likviditas + szerver oldali swap).
MEGRENDELO_CIM=0x0000000000000000000000000000000000000000

# ---------- Webapp ----------
APP_HOST=127.0.0.1
APP_PORT=8060
# A Circle-mod (szerver tarcajaval valtas) csak ezzel a tokennel erheto el. Min. 16 karakter,
# pl.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ha ures, a Circle-mod iro vegpontjai le vannak tiltva (csak MetaMask-mod).
VALTO_ADMIN_TOKEN=
# Alap slippage (bazispont, 50 = 0,5%) es a lanc-oldali hatarido (mp)
ALAP_SLIPPAGE_BPS=50
TX_HATARIDO_MP=600

# ---------- Kezdo likviditas (pool_feltoltes.py) ----------
# mennyisegA,mennyisegB - az ELSO beteves aranya = a pool kezdo ara! Igazitsd a piaci arfolyamhoz.
# POOL_USDC_EURC=1000,920
# POOL_USDC_CIRBTC=1000,0.01

# ---------- Ugynok (opcionalis; ERC-8183 piacter) ----------
# Mainneten nincs Circle-fele referencia AgenticCommerce - a sajat telepitesed cimet add meg.
# AGENTIC_COMMERCE_CIM=0x...
# AGENTBOND_CIM=0x...
# STREAMPAY_CIM=0x...
# COMMITSTAKE_CIM=0x...
# UGYNOK_MAX_VALTAS_USDC=100
